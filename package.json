{
  "name": "the-artificial-intelligence-guestbook",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "lint:md": "markdownlint-cli2",
    "fix:md": "markdownlint-cli2 --fix",
    "fmt:json": "prettier --write \"**/*.json\"",
    "lint:json": "prettier --check \"**/*.json\"",
    "test": "uv run pytest",
    "lint:py": "uv run ruff check app && uv run ruff format --check app",
    "fix:py": "uv run ruff check --fix app && uv run ruff format app"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1"
  }
}
